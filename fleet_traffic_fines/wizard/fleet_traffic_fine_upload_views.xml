<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_traffic_fine_upload_view_form" model="ir.ui.view">
        <field name="name">fleet.traffic.fine.upload.form</field>
        <field name="model">fleet.traffic.fine.upload</field>
        <field name="arch" type="xml">
            <form string="Upload notice">
                <p class="text-muted">
                    The notice is sent to vyto, which reads it and creates the case. It shows up here with the next sync.
                </p>
                <group>
                    <field name="vehicle_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Send to vyto" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fleet_traffic_fine_upload" model="ir.actions.act_window">
        <field name="name">Upload notice</field>
        <field name="res_model">fleet.traffic.fine.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
